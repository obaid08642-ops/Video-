  "ref": -25.520422654230615,
  "dev": 0.15111040766365846,
  "fix": 0.0,
  "level_after": -25.369312246566956
 },
 {
  "line": 22,
  "scene": 5,
  "start": 80.419,
  "end": 83.712,
