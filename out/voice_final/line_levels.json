  "level_after": -25.695668408795825
 },
 {
  "line": 9,
  "scene": 2,
  "start": 26.369,
  "end": 32.436,
  "text": "لكن سنة ألف تسعمية تمانية وعشرين ألكسندر فليمنج لاحظ إن عفن نزل على طبق بكتيريا والبكتيريا اللي حواليه ماتت",
