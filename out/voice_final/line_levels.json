  "ref": -23.349591779353837,
  "dev": 0.015899747259020103,
  "fix": 0.0,
  "level_after": -23.333692032094817
 },
 {
  "line": 17,
  "scene": 3,
  "start": 61.213,
  "end": 66.314,
  "text": "فلو اتصرف لالتهاب حلق أو دور برد بنحرق آخر كارت على الفاضي",
