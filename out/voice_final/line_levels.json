  "ref": -25.453634780587343,
  "dev": 0.10646271978357191,
  "fix": 0.0,
  "level_after": -25.34717206080377
 },
 {
  "line": 36,
  "scene": 8,
  "start": 141.35,
  "end": 142.491,
  "text": "فافتكر تلات حاجات",
  "level": -26.22410604090532,
  "ref": -25.453634780587343,
  "dev": -0.7704712603179757,
  "fix": 0.0,
  "level_after": -26.22410604090532
 },
