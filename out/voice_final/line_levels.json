  "fix": 0.0,
  "level_after": -26.233894015307
 },
 {
  "line": 15,
  "scene": 3,
  "start": 47.459,
  "end": 51.213,
  "text": "مضادات أساسية للالتهابات العادية ومضادات تحت المراقبة تتستخدم بحذر",
