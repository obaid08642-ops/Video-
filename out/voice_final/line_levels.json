  "ref": -23.356607668920688,
  "dev": 0.7186806949982554,
  "fix": 0.0,
  "level_after": -22.637926973922433
 },
 {
  "line": 18,
  "scene": 4,
  "start": 66.914,
  "end": 73.31,
  "text": "وده جواب سؤالنا الصيدلي بيرفض لأن البرد والإنفلونزا وأغلب التهابات الحلق سببها فيروسات",
