  "dev": 0.35113608552525477,
  "fix": 0.0,
  "level_after": -22.566278068329368
 },
 {
  "line": 12,
  "scene": 2,
  "start": 39.484,
  "end": 42.067,
  "text": "ومع الأربعينات أنقذ ملايين الأرواح",
