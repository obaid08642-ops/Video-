  "ref": -23.45845604642188,
  "dev": -0.6175687425070961,
  "fix": 0.0,
  "level_after": -24.076024788928976
 },
 {
  "line": 24,
  "scene": 5,
  "start": 89.828,
  "end": 91.896,
