  "scene": 9,
  "start": 157.576,
  "end": 161.08,
  "text": "لو حابين نتكلم أكتر عن المضادات أو أي موضوع تاني قولولي في الكومنتات",
  "level": -26.472569647485944,
  "ref": -25.588802479400165,
  "dev": -0.8837671680857788,
  "fix": 0.0,
  "level_after": -26.472569647485944
 }
