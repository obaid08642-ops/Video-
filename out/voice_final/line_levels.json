  "ref": -23.09009553133729,
  "dev": -0.8507913363447486,
  "fix": 0.0,
  "level_after": -23.92599127616533
 },
 {
  "line": 16,
  "scene": 3,
  "start": 54.146,
  "end": 60.863,
  "text": "ومضادات احتياطي زي اللينزوليد والكوليستين وغيرهم مش لأنها أقوى لأنها آخر كارت في إيد الدكتور",
