  "ref": -23.67526510624166,
  "dev": 1.26266693849157,
  "fix": 0.0,
  "level_after": -22.41259816775009
 },
 {
  "line": 33,
  "scene": 6,
  "start": 118.575,
  "end": 123.41,
  "text": "البكتيريا بتاعتها اتجرب عليها ست وعشرين مضاد ولا واحد اشتغل",
