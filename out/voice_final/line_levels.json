  "ref": -23.137248112112037,
  "dev": 0.7614294355863755,
  "fix": 0.0,
  "level_after": -22.37581867652566
 },
 {
  "line": 35,
  "scene": 7,
  "start": 126.544,
  "end": 136.823,
  "text": "وهي مش لوحدها حسب دراسة في لانسيت البكتيريا المقاومة قتلت سنة ألفين وتسعتاشر حوالي مليون وربع يعني أكتر من الإيدز وأكتر من الملاريا",
  "level": -23.19771994124467,
  "ref": -23.25509875815857,
  "dev": 0.05737881691390001,
  "fix": 0.0,
  "level_after": -23.19771994124467
 },
