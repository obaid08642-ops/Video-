  "ref": -22.8487755692614,
  "dev": -0.4574589931683697,
  "fix": 0.0,
  "level_after": -23.297580616221126
 },
 {
  "line": 10,
  "scene": 2,
  "start": 34.579,
  "end": 36.521,
  "text": "العفن ده كان بيطلع البنسلين",
