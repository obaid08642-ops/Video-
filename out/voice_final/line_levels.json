  "fix": 0.0,
  "level_after": -25.555545152475307
 },
 {
  "line": 17,
  "scene": 3,
  "start": 58.62,
  "end": 63.591,
  "text": "فلو اتصرف لالتهاب حلق أو دور برد بنحرق آخر كارت على الفاضي",
