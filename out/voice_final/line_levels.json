  "scene": 8,
  "start": 145.603,
  "end": 146.744,
  "text": "فافتكر تلات حاجات",
  "level": -24.15738612810991,
  "ref": -23.137248112112037,
  "dev": -1.0201380159978726,
  "fix": 0.0,
  "level_after": -24.15738612810991
 },
