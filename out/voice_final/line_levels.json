 },
 {
  "line": 5,
  "scene": 1,
  "start": 13.035,
  "end": 18.141,
  "text": "وفي الآخر كمان هحكيلك عن قصة ست الدكاترة جربوا عليها كل المضادات والنتيجة كانت صادمة",
