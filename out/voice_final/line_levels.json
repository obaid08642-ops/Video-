  "line": 42,
  "scene": 9,
  "start": 162.129,
  "end": 165.633,
  "text": "لو حابين نتكلم أكتر عن المضادات أو أي موضوع تاني قولولي في الكومنتات",
  "level": -24.61415050948681,
  "ref": -23.1965687213315,
  "dev": -1.41758178815531,
  "fix": 0.0,
  "level_after": -24.61415050948681
 }
