  "scene": 9,
  "start": 158.536,
  "end": 162.039,
  "text": "المضاد الحيوي مش قوة خارقة استخدامك الصح هو اللي بيحافظ على قوته",
  "level": -23.321548036668425,
  "ref": -23.723002444694764,
  "dev": 0.40145440802633914,
  "fix": 0.0,
  "level_after": -23.321548036668425
 },
