  "fix": 0.0,
  "level_after": -22.93231177165247
 },
 {
  "line": 21,
  "scene": 4,
  "start": 77.706,
  "end": 82.841,
  "text": "يعني هتاخده ومش هتخف أسرع وهتدفع التمن من البكتيريا النافعة اللي في بطنك",
