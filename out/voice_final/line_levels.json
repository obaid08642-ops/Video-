  "ref": -22.925104449434198,
  "dev": -0.3374431284324011,
  "fix": 0.0,
  "level_after": -23.2625475778666
 },
 {
  "line": 9,
  "scene": 2,
  "start": 28.302,
  "end": 34.369,
  "text": "لكن سنة ألف تسعمية تمانية وعشرين ألكسندر فليمنج لاحظ إن عفن نزل على طبق بكتيريا والبكتيريا اللي حواليه ماتت",
