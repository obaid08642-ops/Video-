  "ref": -25.513272969672474,
  "dev": 0.24538323738860868,
  "fix": 0.0,
  "level_after": -25.267889732283866
 },
 {
  "line": 7,
  "scene": 2,
  "start": 20.905,
  "end": 22.377,
  "text": "خربوش صغير كان ممكن يموتك",
