  "scene": 8,
  "start": 148.628,
  "end": 153.383,
  "text": "تلاتة لو الدكتور كتبه التزم بالجرعة والمدة ولو حسيت إنك خفيت متوقفش",
  "level": -25.406756053776807,
  "ref": -25.78402034618356,
  "dev": 0.3772642924067533,
  "fix": 0.0,
  "level_after": -25.406756053776807
 },
