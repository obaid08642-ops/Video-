  "ref": -24.059864391772255,
  "dev": -0.7227309295816049,
  "fix": 0.0,
  "level_after": -24.78259532135386
 },
 {
  "line": 28,
  "scene": 6,
  "start": 102.439,
  "end": 109.337,
  "text": "لما المضاد ميجيبش نتيجة الدكتور بيعمل مزرعة ياخد عينة يزرع البكتيريا ويجرب عليها المضادات ويشوف مين يقتلها",
  "level": -24.107001027784996,
  "ref": -24.34985215024972,
  "dev": 0.2428511224647245,
  "fix": 0.0,
  "level_after": -24.107001027784996
 },
 {
  "line": 29,
  "scene": 6,
  "start": 109.807,
  "end": 112.1,
  "text": "وده اللي حصل مع الست اللي وعدتك بقصتها",
  "level": -25.279209382879607,
  "ref": -24.01205500346529,
  "dev": -1.2671543794143183,
  "fix": 0.0,
  "level_after": -25.279209382879607
 },
