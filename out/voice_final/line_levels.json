  "ref": -23.155917538699512,
  "dev": 0.10886707303832566,
  "fix": 0.0,
  "level_after": -23.047050465661187
 },
 {
  "line": 22,
  "scene": 5,
  "start": 83.442,
  "end": 86.735,
  "text": "والأخطر إن كل مضاد من غير داعي بيدرب البكتيريا",
