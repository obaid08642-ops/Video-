  "ref": -25.618922664989864,
  "dev": 0.6182429573614421,
  "fix": 0.0,
  "level_after": -25.00067970762842
 },
 {
  "line": 8,
  "scene": 2,
  "start": 22.585,
  "end": 25.907,
  "text": "البكتيريا تدخل من الجرح توصل للدم ومفيش دوا يوقفها",
