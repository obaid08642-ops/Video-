  "ref": -22.917414153854622,
  "dev": 0.15657374347997788,
  "fix": 0.0,
  "level_after": -22.760840410374644
 },
 {
  "line": 13,
  "scene": 3,
  "start": 42.237,
  "end": 46.401,
