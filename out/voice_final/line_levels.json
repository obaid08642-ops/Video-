  "scene": 9,
  "start": 153.983,
  "end": 157.486,
  "text": "المضاد الحيوي مش قوة خارقة استخدامك الصح هو اللي بيحافظ على قوته",
  "level": -25.770848905023524,
  "ref": -25.797191787343596,
  "dev": 0.026342882320072647,
  "fix": 0.0,
  "level_after": -25.770848905023524
 },
