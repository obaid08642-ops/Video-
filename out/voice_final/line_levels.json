  "scene": 8,
  "start": 150.198,
  "end": 152.69,
  "text": "اتنين البرد والإنفلونزا ملهمش مضاد",
  "level": -23.723002444694764,
  "ref": -23.1965687213315,
  "dev": -0.5264337233632652,
  "fix": 0.0,
  "level_after": -23.723002444694764
 },
 {
  "line": 40,
  "scene": 8,
  "start": 152.991,
  "end": 157.936,
  "text": "تلاتة لو الدكتور كتبه التزم بالجرعة والمدة ولو حسيت إنك خفيت متوقفش",
  "level": -23.071589405994573,
  "ref": -23.522275240681594,
  "dev": 0.4506858346870217,
  "fix": 0.0,
  "level_after": -23.057898878245556
 },
