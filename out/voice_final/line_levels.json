  "ref": -25.35035583180381,
  "dev": -0.7696365258986262,
  "fix": 0.0,
  "level_after": -26.119992357702436
 },
 {
  "line": 16,
  "scene": 3,
  "start": 51.553,
  "end": 58.27,
  "text": "ومضادات احتياطي زي اللينزوليد والكوليستين وغيرهم مش لأنها أقوى لأنها آخر كارت في إيد الدكتور",
