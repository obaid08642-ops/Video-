  "line": 36,
  "scene": 7,
  "start": 137.384,
  "end": 144.752,
  "text": "ولو المضادات بطلت تشتغل الولادة القيصرية والعمليات والكيماوي كلها تبقى في خطر كبير",
  "level": -23.076776282979402,
  "ref": -23.085812863245813,
  "dev": 0.009036580266410965,
  "fix": 0.0,
  "level_after": -23.076776282979402
 },
 {
