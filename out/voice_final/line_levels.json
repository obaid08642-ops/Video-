  "fix": 0.0,
  "level_after": -24.27613158202182
 },
 {
  "line": 15,
  "scene": 3,
  "start": 50.052,
  "end": 53.806,
  "text": "مضادات أساسية للالتهابات العادية ومضادات تحت المراقبة تتستخدم بحذر",
