  "ref": -24.52087170845161,
  "dev": 0.6191525877340673,
  "fix": 0.0,
  "level_after": -23.901719120717544
 },
 {
  "line": 3,
  "scene": 1,
  "start": 6.125,
  "end": 10.132,
  "text": "واحد من أهم اكتشافات تاريخ الطب الاكتشاف اللي اتولد بالصدفة في معمل صغير",
