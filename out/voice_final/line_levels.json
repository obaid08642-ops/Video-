  "ref": -23.01169399412062,
  "dev": 0.02336471699113929,
  "fix": 0.0,
  "level_after": -22.98832927712948
 },
 {
  "line": 11,
  "scene": 2,
  "start": 36.781,
  "end": 39.114,
