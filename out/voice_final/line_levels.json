  "level": -22.861879621738915,
  "ref": -23.10012840608414,
  "dev": 0.2382487843452239,
  "fix": 0.0,
  "level_after": -22.861879621738915
 },
 {
  "line": 7,
  "scene": 2,
  "start": 21.525,
  "end": 22.997,
  "text": "خربوش صغير كان ممكن يموتك",
  "level": -22.709221861393317,
  "ref": -23.28439107014818,
  "dev": 0.5751692087548648,
  "fix": 0.0,
  "level_after": -22.709221861393317
 },
 {
  "line": 8,
  "scene": 2,
  "start": 23.257,
  "end": 27.702,
  "text": "البكتيريا تدخل من الجرح توصل للدم ومفيش دوا يوقفها",
